<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ParametresController"
      spacing="10" alignment="CENTER"
      style="-fx-padding: 20;">

    <Label text="Modifier vos paramètres" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Nom d'utilisateur:"/>
    <TextField fx:id="usernameField" promptText="Entrez votre nom"/>

    <Label text="Email:"/>
    <TextField fx:id="emailField" promptText="Entrez votre email"/>

    <Button text="Enregistrer" onAction="#handleEnregistrer"/>
    <Button text="Annuler" onAction="#handleAnnuler"/>
</VBox>
