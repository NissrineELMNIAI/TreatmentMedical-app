<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="360.0" prefWidth="397.0" spacing="10" style="-fx-padding: 20; -fx-background-color: rgb(191, 217, 251);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ParametresController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Modifier vos paramètres" textFill="#378ac9" />

    <Label text="Nom d'utilisateur :" textFill="#378ac9">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
    <TextField fx:id="usernameField" prefHeight="34.0" prefWidth="321.0" promptText="Entrez votre nom" style="-fx-background-radius: 20;" />

    <Label text="Email:" textFill="#378ac9">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
    <TextField fx:id="emailField" prefHeight="32.0" prefWidth="358.0" promptText="Entrez votre email" style="-fx-background-radius: 20;" />
   <AnchorPane prefHeight="0.0" prefWidth="358.0">
      <children>
      
                      <Button layoutX="262.0" layoutY="18.0" onAction="#handleEnregistrer" prefHeight="27.0" prefWidth="81.0" style="-fx-background-color: #378ac9;" text="Enregistrer" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
          <Button layoutX="170.0" layoutY="18.0" onAction="#handleAnnuler" prefHeight="27.0" prefWidth="74.0" style="-fx-background-color: #378ac9; -fx-padding-left: 20px;" text="Annuler" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
      </children>
   </AnchorPane>
</VBox>
