<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.compteController"
            prefWidth="400" prefHeight="300"
            style="-fx-background-color: #f9faff; -fx-padding: 20;">
    
    <children>
        <!-- Titre en haut -->
        <Label text="Mon compte"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #222;"
               AnchorPane.topAnchor="15"
               AnchorPane.leftAnchor="20"/>

        <!-- Conteneur principal vertical -->
        <VBox spacing="20" AnchorPane.topAnchor="60" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
            
            <!-- Photo de profil avec bouton modifier -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <ImageView fx:id="profileImageView"
                           fitWidth="80" fitHeight="80"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 0); -fx-background-radius: 40;"
                           pickOnBounds="true" preserveRatio="true"/>
                
                <VBox spacing="8">
                    <Label fx:id="nomLabel" text="Jean Dupont"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                    <Label fx:id="emailLabel" text="jean.dupont@example.com"
                           style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                    
                    <Button text="Modifier la photo"
                            onAction="#handleModifierPhoto"
                            style="-fx-background-color: transparent; -fx-text-fill: #007bff; -fx-underline: true; -fx-padding: 0;"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- Boutons d'action -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Paramètres du compte" onAction="#handleParametres"
                        style="-fx-background-color: #5a8dee; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 130; -fx-cursor: hand;">
                    <style>
                        .button:hover {
                            -fx-background-color: #4a7edc;
                        }
                    </style>
                </Button>
                
                <Button text="Ajouter un compte" onAction="#handleAjouterCompte"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 130; -fx-cursor: hand;">
                    <style>
                        .button:hover {
                            -fx-background-color: #218838;
                        }
                    </style>
                </Button>
                
                <Button text="Déconnexion" onAction="#handleDeconnexion"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 130; -fx-cursor: hand;">
                    <style>
                        .button:hover {
                            -fx-background-color: #c82333;
                        }
                    </style>
                </Button>
            </HBox>

            <!-- Message de bienvenue -->
            <Label fx:id="welcomeLabel" text="Bienvenue sur votre espace personnel !"
                   style="-fx-font-size: 13px; -fx-text-fill: #888;" />
        </VBox>
    </children>
</AnchorPane>
