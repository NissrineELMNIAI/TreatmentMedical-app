<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: rgb(191, 217, 251);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.accueilController">
   <children>
      <Label layoutX="295.0" layoutY="91.0" prefHeight="44.0" prefWidth="115.0" style="-fx-font-style: italic;" text="Bienvenue dans :" textAlignment="CENTER" textFill="#378ac9" textOverrun="LEADING_ELLIPSIS">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <Label layoutX="120.0" layoutY="342.0" prefHeight="44.0" prefWidth="465.0" style="-fx-font-style: italic;" text="MemoPharma vous permet de gérer le suivi de traitements médicaux de vos patients " textFill="#378ac9">
         <font>
            <Font size="14.0" />
         </font></Label>
      <HBox prefHeight="50.0" prefWidth="705.0" style="-fx-background-color: rgb(191, 217, 251);">
         <children>
            <ImageView fitHeight="69.0" fitWidth="115.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: rgb(191, 217, 251);">
               <image>
                  <Image url="@../icons/sansBackground1.png" />
               </image>
            </ImageView>
            <Button fx:id="buttonPatient" mnemonicParsing="false" onAction="#ouvrirPatients" prefHeight="51.0" prefWidth="142.0" style="-fx-background-color: white;" text="Mes Patients" textFill="#378ac9">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="buttonTraitement" mnemonicParsing="false" onAction="#ouvrirTraitements" prefHeight="52.0" prefWidth="142.0" style="-fx-background-color: white;" text="Mes Traitements" textFill="#378ac9">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="buttonRendezVous" mnemonicParsing="false" onAction="#ouvrirRendezVous" prefHeight="57.0" prefWidth="143.0" style="-fx-background-color: white;" text="Mes Rendez-Vous" textFill="#378ac9">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button fx:id="staticon" mnemonicParsing="false" onAction="#ouvrirStatistiques" prefHeight="50.0" prefWidth="101.0" style="-fx-background-color: white;">
               <graphic>
                  <ImageView accessibleRole="BUTTON" fitHeight="39.0" fitWidth="64.0" onMouseClicked="#ouvrirStatistiques" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/statistique.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="buttoncompt" mnemonicParsing="false" onAction="#handleCompteClick" prefHeight="50.0" prefWidth="74.0" style="-fx-background-color: white;">
               <graphic>
                  <ImageView fx:id="connexicon" accessibleRole="BUTTON" fitHeight="37.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/profile.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
      <ImageView fitHeight="304.0" fitWidth="333.0" layoutX="199.0" layoutY="91.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../icons/sansBackground.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
