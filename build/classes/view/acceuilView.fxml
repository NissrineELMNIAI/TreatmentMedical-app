      <Label layoutX="295.0" layoutY="91.0" prefHeight="44.0" prefWidth="115.0" style="-fx-font-style: italic;" text="Bienvenue dans :" textAlignment="CENTER" textFill="#378ac9" textOverrun="LEADING_ELLIPSIS">
