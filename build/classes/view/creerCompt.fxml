<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400" prefWidth="400" style="-fx-background-color: #f0f8ff;" 
            xmlns:fx="http://javafx.com/fxml/1" 
            xmlns="http://javafx.com/javafx/23.0.1" 
            fx:controller="controller.creerComptController">

    <children>

        <Label layoutX="94.0" layoutY="22.0" prefHeight="32.0" prefWidth="217.0" 
               style="-fx-font-weight: bold;" text="Créer votre compte" textFill="#320be4">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <TextField fx:id="usernameField" layoutX="52.0" layoutY="75.0" 
                   prefHeight="30.0" prefWidth="300.0" promptText="Nom d'utilisateur" />

        <TextField fx:id="emailField" layoutX="51.0" layoutY="125.0" 
                   prefHeight="30.0" prefWidth="300.0" promptText="Email" />

        <PasswordField fx:id="passwordField" layoutX="52.0" layoutY="175.0" 
                       prefHeight="30.0" prefWidth="300.0" promptText="Mot de passe" />

        <PasswordField fx:id="confirmPasswordField" layoutX="50.0" layoutY="224.0" 
                       prefHeight="30.0" prefWidth="300.0" promptText="Confirmer mot de passe" />

        <Button fx:id="createAccountButton" layoutX="142.0" layoutY="279.0" 
                text="Créer le compte" />

        <Label fx:id="loginLinkLabel" layoutX="110.0" layoutY="330.0" 
               text="Déjà un compte ? Se connecter"
               textFill="blue" underline="true" style="-fx-cursor: hand;" />

    </children>
</AnchorPane>
