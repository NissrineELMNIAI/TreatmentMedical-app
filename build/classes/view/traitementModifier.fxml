<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="360.0" prefWidth="400.0" style="-fx-background-color: rgb(191, 217, 251);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.traitementModifierController">
   <children>
      <Label layoutX="114.0" layoutY="42.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Modifier Traitement" textFill="#378ac9" />
      <Label layoutX="22.0" layoutY="101.0" text="Nom :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="txtType" layoutX="117.0" layoutY="130.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <Label layoutX="25.0" layoutY="134.0" text="Prix :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="txtFoisParJour" layoutX="117.0" layoutY="97.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <Label layoutX="24.0" layoutY="207.0" text="Fois/Jour :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="txtDuree" layoutX="117.0" layoutY="237.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <Label layoutX="22.0" layoutY="171.0" text="Type :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="txtNom" layoutX="117.0" layoutY="167.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <Label layoutX="26.0" layoutY="241.0" text="Durée :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="txtPrix" layoutX="117.0" layoutY="203.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <Button fx:id="btnSave" layoutX="286.0" layoutY="281.0" onAction="#handleSave" style="-fx-background-color: #378ac9;" text="Enregistrer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="btnCancel" layoutX="200.0" layoutY="281.0" onAction="#handleCancel" prefHeight="26.0" prefWidth="62.0" style="-fx-background-color: #378ac9;" text="Annuler" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
