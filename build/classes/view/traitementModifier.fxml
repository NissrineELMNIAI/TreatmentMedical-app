<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8"
      fx:controller="controller.traitementModifierController"
      spacing="15" alignment="CENTER" prefWidth="400" prefHeight="350"
      style="-fx-background-color: #f0f8ff; -fx-padding: 20;">

    <Label text="Modifier Traitement" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Prix :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrix" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Fois/Jour :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFoisParJour" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Type :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtType" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Durée :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDuree" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnSave" text="Enregistrer" onAction="#handleSave" />
        <Button fx:id="btnCancel" text="Annuler" onAction="#handleCancel" />
    </HBox>
</VBox>
