<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgb(191, 217, 251);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfilController">
    <Label text="Mon Compte" textFill="#378ac9" />
    <Label fx:id="nomLabel" />
    <Label fx:id="emailLabel" />
    <Button onAction="#handleLogout" style="-fx-background-color: #378ac9;" text="Se déconnecter" textFill="WHITE">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Button>
</VBox>
