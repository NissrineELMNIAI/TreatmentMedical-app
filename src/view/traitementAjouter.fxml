<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="360.0" prefWidth="400.0" style="-fx-background-color: rgb(191, 217, 251);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.traitementAjouterController">
   <children>
      <Label layoutX="29.0" layoutY="53.0" text="Nom :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="33.0" layoutY="93.0" text="Prix :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="31.0" layoutY="133.0" text="Fois/Jour :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="30.0" layoutY="175.0" text="Type :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="33.0" layoutY="219.0" text="Durée :" textFill="#378ac9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      
      <TextField fx:id="txtNom" layoutX="120.0" layoutY="49.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <TextField fx:id="txtPrix" layoutX="120.0" layoutY="89.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <TextField fx:id="txtFoisParJour" layoutX="120.0" layoutY="129.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <TextField fx:id="txtType" layoutX="120.0" layoutY="171.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      <TextField fx:id="txtDuree" layoutX="120.0" layoutY="215.0" prefWidth="250.0" style="-fx-background-radius: 20;" />
      
      <Button fx:id="btnAjouter" layoutX="286.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleAjouter" prefHeight="26.0" prefWidth="62.0" style="-fx-background-color: #378ac9;" text="Ajouter" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button layoutX="200.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleCancel" prefHeight="26.0" prefWidth="62.0" style="-fx-background-color: #378ac9;" text="Annuler" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
