<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="350.0" prefWidth="400.0" style="-fx-background-color: #f0f8ff;" 
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.traitementAjouterController">
   <children>
      <Label layoutX="30.0" layoutY="40.0" text="Nom :" />
      <Label layoutX="30.0" layoutY="80.0" text="Prix :" />
      <Label layoutX="30.0" layoutY="120.0" text="Fois/Jour :" />
      <Label layoutX="30.0" layoutY="160.0" text="Type :" />
      <Label layoutX="30.0" layoutY="200.0" text="Durée :" />
      
      <TextField fx:id="txtNom" layoutX="120.0" layoutY="35.0" prefWidth="250.0" />
      <TextField fx:id="txtPrix" layoutX="120.0" layoutY="75.0" prefWidth="250.0" />
      <TextField fx:id="txtFoisParJour" layoutX="120.0" layoutY="115.0" prefWidth="250.0" />
      <TextField fx:id="txtType" layoutX="120.0" layoutY="155.0" prefWidth="250.0" />
      <TextField fx:id="txtDuree" layoutX="120.0" layoutY="195.0" prefWidth="250.0" />
      
      <Button fx:id="btnAjouter" layoutX="160.0" layoutY="250.0" mnemonicParsing="false" 
              onAction="#handleAjouter" prefWidth="80.0" text="Ajouter" />
   </children>
</AnchorPane>