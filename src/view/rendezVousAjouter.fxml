<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300" prefWidth="400" style="-fx-background-color: #e6f2ff;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RendezVousAjouterController">
    <children>
        <Label layoutX="30" layoutY="30" text="Date :" />
        <DatePicker fx:id="datePicker" layoutX="120" layoutY="26" prefWidth="200" />
        <Label layoutX="30" layoutY="70" text="Heure :" />
        <ComboBox fx:id="comboHeure" layoutX="120" layoutY="66" prefWidth="200" />
        <Label layoutX="30" layoutY="110" text="Objet :" />
        <TextField fx:id="textFieldObjet" layoutX="120" layoutY="106" prefWidth="200" />
        <Button fx:id="btnAdd" layoutX="120" layoutY="210" mnemonicParsing="false" onAction="#handleAdd" text="Ajouter" />
        <Button fx:id="btnCancel" layoutX="230" layoutY="210" mnemonicParsing="false" onAction="#handleCancel" text="Annuler" />
    </children>
</AnchorPane>